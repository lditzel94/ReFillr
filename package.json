{
  "name": "refillr",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preview": "ng build && wrangler pages dev dist/refillr/browser",
    "db:start": "supabase db start",
    "db:test": "supabase test db",
    "db:stop": "supabase stop",
    "db:types": "supabase gen types typescript --local --schema public > src/app/core/database.types.ts && prettier --write src/app/core/database.types.ts",
    "start:local": "ng serve --configuration local"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "supabase": "^3.1.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.155.0"
  }
}
