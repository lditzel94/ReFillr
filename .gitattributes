# Store text files with LF in the repository; check out with native endings.
* text=auto

# These must keep LF even on a Windows checkout. macOS and Linux cannot execute
# a script whose lines end in CRLF -- it fails with "bad interpreter: /bin/sh^M",
# which is exactly how this would surface on the iOS CI runner.
gradlew text eol=lf
*.sh text eol=lf

# Windows-only scripts keep CRLF.
gradlew.bat text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Xcode project files are line-ending sensitive and merge badly; leave them alone.
*.pbxproj -text

# Binaries git must not touch.
*.png binary
*.jpg binary
*.jar binary
*.zip binary
*.keystore binary
*.jks binary
